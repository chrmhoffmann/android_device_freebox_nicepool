## Bluetooth
bluetooth.device.default_name=Freebox Player POP
bluetooth.profile.hfp.ag.enabled=false
bluetooth.profile.opp.enabled=false
bluetooth.profile.pbap.server.enabled=false

## FRP
#ro.frp.pst=/dev/block/by-name/frp

# Dolby
ro.vendor.platform.support.dolbyvision=false
vendor.media.support.dolbyvision=false

## NRDP
ro.vendor.nrdp.audio.mixer.buffersize=1024
ro.vendor.nrdp.modelgroup=FBXBG02A
ro.vendor.nrdp.validation=ninja_7

## SOC
ro.soc.model=AMLS905X2

## Wi-Fi
vendor.bcm_wifi=bcm
